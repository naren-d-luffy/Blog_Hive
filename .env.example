# App
PORT=5000
NODE_ENV=development

# Database
DB_URL=your_mongodb_url

# Login Security
LOGIN_FAILURE_COUNT=3
LOCK_UNTIL_TIME=15

# Auth
ACCESS_TOKEN=your_access_token_secret
HASH_TOKEN=your_hash_token_secret

#Redis
REDIS_HOST=ip
REDIS_PORT=6379

#Rate Limiter
LOGIN_BUCKET_CAPACITY=5
LOGIN_BUCKET_REFILLRATE=0.05

GLOBAL_BUCKET_CAPACITY=5
GLOBAL_BUCKET_REFILLRATE=0.1

#Slug
MAX_SLUG_LENGTH=80

#CORS
CORS_ORGINS=http://localhost:3000

#Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Your Email here
SMTP_PASS=Your password here
EMAIL_FROM="User Name or user email"
FRONTEND_URL=http://localhost:3000

#Log
LOG_LEVEL="info"

# MCP Server Configuration
MCP_TRANSPORT=streamable-http
MCP_PORT=3001
MCP_HOST=ip
MCP_ENDPOINT=/mcp

# MCP Session Configuration
MCP_SESSION_IDLE_TIMEOUT_MS=1800000
MCP_MAX_SESSIONS=1000

# MCP Security Configuration
MCP_ALLOWED_HOSTS=ip,localhost
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_STRICT_AUTH=false

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URI=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_CERTS_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
BACKEND_URL=http://localhost:3000